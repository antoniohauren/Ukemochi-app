package web

import (
	"strconv"
	"time"

	"github.com/antoniohauren/ukemochi/internal/db"
	"github.com/antoniohauren/ukemochi/internal/money"
)

templ ReportPage(day time.Time, rep db.Report, cash cashBox, summary string) {
	@Layout("Relatório · Ukemochi") {
		<main class="mx-auto max-w-lg space-y-4 p-4">
			<header class="flex items-center gap-2">
				@HomeLink()
				<h1 class="flex-1 text-xl font-bold">Relatório</h1>
				<a href="/admin/cardapio" class="inline-flex min-h-12 items-center px-3 text-sm font-medium text-ink-muted underline">Cardápio</a>
			</header>
			<form method="get" action="/admin/relatorio" class="flex items-center gap-2">
				<a href={ templ.SafeURL("/admin/relatorio?dia=" + day.AddDate(0, 0, -1).Format(dayLayout)) } class={ buttonClass("secondary") + " w-12 px-0" } aria-label="Dia anterior">‹</a>
				<input type="date" name="dia" value={ day.Format(dayLayout) } onchange="this.form.submit()" class={ fieldClass() + " flex-1" } aria-label="Dia"/>
				<a href={ templ.SafeURL("/admin/relatorio?dia=" + day.AddDate(0, 0, 1).Format(dayLayout)) } class={ buttonClass("secondary") + " w-12 px-0" } aria-label="Próximo dia">›</a>
				<noscript>
					@Button("secondary", templ.Attributes{"type": "submit"}) {
						Ver
					}
				</noscript>
			</form>
			@Card() {
				<p class="text-sm text-ink-muted">{ day.Format("02/01/2006") } · pedidos fechados</p>
				<p class="mt-1 text-3xl font-bold tabular-nums">{ money.Format(rep.TotalCents) }</p>
				<p class="text-ink-muted">{ plural(rep.Orders, "pedido", "pedidos") }</p>
			}
			@cashCard(day, cash)
			if rep.Orders == 0 {
				<p class="py-4 text-center text-ink-muted">Nenhum pedido fechado neste dia.</p>
			} else {
				@reportTable("Por pagamento", rep.ByPayment, paymentLabels)
				@reportTable("Por canal", rep.ByChannel, channelLabels)
				@Card() {
					<h2 class="mb-2 font-semibold">Mais vendidos</h2>
					<ul class="divide-y divide-line">
						for _, it := range rep.TopItems {
							<li class="flex justify-between gap-3 py-2">
								<span class="min-w-0">{ strconv.FormatInt(it.Qty, 10) }x { it.Name }</span>
								<span class="shrink-0 tabular-nums text-ink-muted">{ money.Format(it.TotalCents) }</span>
							</li>
						}
					</ul>
				}
				<div class="grid gap-2">
					@Button("primary", templ.Attributes{"type": "button", "data-copy": "resumo-texto"}) {
						Copiar resumo
					}
					<textarea id="resumo-texto" readonly rows="12" class="hidden w-full rounded-xl border border-line bg-card p-3 text-sm">{ summary }</textarea>
				</div>
			}
		</main>
		@copyScript()
	}
}

templ reportTable(title string, rows []db.ReportRow, labels map[string]string) {
	@Card() {
		<h2 class="mb-2 font-semibold">{ title }</h2>
		<ul class="divide-y divide-line">
			for _, row := range rows {
				<li class="flex justify-between gap-3 py-2">
					<span>{ label(labels, row.Key) } <span class="text-ink-muted">· { strconv.FormatInt(row.Orders, 10) }</span></span>
					<span class="tabular-nums font-medium">{ money.Format(row.TotalCents) }</span>
				</li>
			}
		</ul>
	}
}

// plural writes n with the singular or plural noun: "1 pedido", "3 pedidos".
func plural(n int64, one, many string) string {
	if n == 1 {
		return "1 " + one
	}
	return strconv.FormatInt(n, 10) + " " + many
}

// cashCard shows the expected cash in the drawer: the caixa inicial plus cash received on closed orders.
templ cashCard(day time.Time, cash cashBox) {
	@Card() {
		<h2 class="mb-2 font-semibold">Caixa</h2>
		<ul class="divide-y divide-line">
			<li class="flex justify-between gap-3 py-2">
				<span>Caixa inicial</span>
				<span class="tabular-nums font-medium">{ money.Format(cash.OpeningCents) }</span>
			</li>
			<li class="flex justify-between gap-3 py-2">
				<span>Dinheiro recebido</span>
				<span class="tabular-nums font-medium">{ money.Format(cash.ReceivedCents) }</span>
			</li>
			<li class="flex justify-between gap-3 py-2 text-lg font-bold">
				<span>Caixa esperado</span>
				<span class="tabular-nums">{ money.Format(cash.ExpectedCents()) }</span>
			</li>
		</ul>
		<form method="post" action="/admin/relatorio/caixa" class="mt-3 flex items-end gap-2">
			<input type="hidden" name="dia" value={ day.Format(dayLayout) }/>
			<div class="min-w-0 flex-1">
				@MoneyInput("caixa_inicial", "Caixa inicial", plainMoney(cash.OpeningCents), nil)
			</div>
			@Button("secondary", templ.Attributes{"type": "submit"}) {
				Salvar
			}
		</form>
	}
}
