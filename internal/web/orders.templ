package web

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/antoniohauren/ukemochi/internal/db"
	"github.com/antoniohauren/ukemochi/internal/money"
)

templ OrderListPage(orders []db.Order) {
	@Layout("Pedidos · Ukemochi") {
		<main class="mx-auto max-w-lg space-y-4 p-4 pb-24">
			<header class="flex items-center justify-between">
				<h1 class="text-2xl font-bold">Pedidos</h1>
				<div class="flex items-center gap-1">
					<button type="button" onclick="toggleTheme()" aria-label="Alternar modo escuro" class="min-h-12 min-w-12 rounded-xl text-xl hover:bg-line">
						<span class="dark:hidden">🌙</span>
						<span class="hidden dark:inline">☀️</span>
					</button>
					<a href="/admin/relatorio" class="inline-flex min-h-12 items-center px-3 text-sm font-medium text-ink-muted underline">Admin</a>
				</div>
			</header>
			// Polls while the tab is visible, so orders from another phone show up; hx-select cuts the list out of the page.
			<div id="lista" hx-get="/" hx-trigger="every 15s [document.visibilityState=='visible']" hx-select="#lista" hx-swap="outerHTML">
				if len(orders) == 0 {
					<p class="py-8 text-center text-ink-muted">Nenhum pedido aberto.</p>
				}
				<ul class="space-y-3">
					for _, o := range orders {
						<li>
							<a href={ templ.SafeURL(orderURL(o.ID)) } class="block active:opacity-80">
								@Card() {
									<div class="flex items-start justify-between gap-3">
										<div class="min-w-0">
											<p class="line-clamp-2 break-words font-semibold">#{ strconv.FormatInt(o.ID, 10) } { o.ClientLabel() }</p>
											<p class="text-sm text-ink-muted">
												{ channelLabels[o.Channel] } · { consumeLabels[o.Consume] } · { localTime(o.CreatedAt, "15:04") }
											</p>
										</div>
										@StatusChip(o.Status)
									</div>
									<div class="mt-2 flex items-center justify-between gap-3">
										<p class="text-lg font-bold tabular-nums">{ money.Format(o.TotalCents) }</p>
										{{ l, paid := payLabel(o) }}
										<span class={ "inline-flex items-center rounded-full px-2 py-0.5 text-sm font-medium tabular-nums ring-1 ring-inset", statusColors[payChipStatus(paid)] }>{ l }</span>
									</div>
								}
							</a>
						</li>
					}
				</ul>
			</div>
		</main>
		<div class="fixed inset-x-0 bottom-0 mx-auto grid max-w-lg p-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
			@LinkButton("primary", "/pedidos/novo") {
				+ Novo pedido
			}
		</div>
	}
}

// payLabel is the home card's payment chip, in every status: "Não pago" (red) until paid, then "Pago" (paid true, green).
// A part payment shows what is left.
func payLabel(o db.Order) (label string, paid bool) {
	switch {
	case o.Paid():
		return "Pago", true
	case o.PaymentCount > 0 && o.RemainingCents() > 0:
		return "Falta " + money.Format(o.RemainingCents()), false
	}
	return "Não pago", false
}

// payChipStatus borrows a status chip's colors: green (pronto) when paid, red (cancelado) when not.
func payChipStatus(paid bool) string {
	if paid {
		return db.StatusReady
	}
	return db.StatusCancelled
}

func optionClass() string {
	return "flex min-h-12 cursor-pointer items-center justify-center rounded-xl border border-line bg-card px-4 font-semibold " +
		"has-[:checked]:border-brand has-[:checked]:bg-brand-soft has-[:checked]:text-brand-ink " +
		// Dark red on near-black is hard to read: in dark mode the chosen tile is solid, like a primary button.
		"dark:has-[:checked]:bg-brand dark:has-[:checked]:text-white"
}

func selectedVariant(selected bool) string {
	if selected {
		return "primary"
	}
	return "secondary"
}

func fieldClass() string {
	// Neutral focus ring; red only marks a field at fault (aria-invalid).
	return "min-h-12 w-full rounded-xl border border-line bg-card px-4 text-lg outline-none focus:border-ink focus:ring-2 focus:ring-ink/20 " +
		"aria-invalid:border-danger aria-invalid:ring-2 aria-invalid:ring-danger/20"
}

// NewOrderPage is the new-order form. errField names the input at fault: errMsg shows under it, or above
// the submit button when errField is empty.
templ NewOrderPage(o db.NewOrder, errMsg, errField string) {
	@Layout("Novo pedido · Ukemochi") {
		<main class="mx-auto max-w-lg p-4">
			<header class="mb-4 flex items-center gap-2">
				@HomeLink()
				<h1 class="text-xl font-bold">Novo pedido</h1>
			</header>
			<form method="post" action="/pedidos" class="group space-y-5">
				<fieldset>
					<legend class="mb-1 text-sm font-medium text-ink-muted">Canal</legend>
					<div class="grid grid-cols-2 gap-2">
						<label class={ optionClass() }>
							<input type="radio" name="canal" value="whatsapp" class="sr-only" checked?={ o.Channel != "balcao" }/>
							WhatsApp
						</label>
						<label class={ optionClass() }>
							<input type="radio" name="canal" value="balcao" id="canal-balcao" class="sr-only" checked?={ o.Channel == "balcao" }/>
							Balcão
						</label>
					</div>
				</fieldset>
				// Balcão is always eaten in (parseNewOrder), so the choice and the address hide.
				<div class="space-y-5 group-has-[#canal-balcao:checked]:hidden">
					<fieldset>
						<legend class="mb-1 text-sm font-medium text-ink-muted">Consumo</legend>
						<div class="grid grid-cols-2 gap-2">
							<label class={ optionClass() }>
								<input type="radio" name="consumo" value="entrega" id="consumo-entrega" class="sr-only" checked?={ o.Consume != db.ConsumeLocal }/>
								Entrega
							</label>
							<label class={ optionClass() }>
								<input type="radio" name="consumo" value="local" class="sr-only" checked?={ o.Consume == db.ConsumeLocal }/>
								No local
							</label>
						</div>
					</fieldset>
					// Shown only while Entrega is checked; the server requires it then.
					<label class="hidden group-has-[#consumo-entrega:checked]:block">
						<span class="mb-1 block text-sm font-medium text-ink-muted">Endereço de entrega</span>
						<input type="text" name="endereco" value={ o.Address } maxlength="120" autocomplete="off" class={ fieldClass() } { invalid(errField, "endereco")... }/>
						@fieldError(errField, "endereco", errMsg)
					</label>
				</div>
				@customerFields(o.ClientName, o.PhoneLast4, o.Notes, errField, errMsg)
				if errMsg != "" && errField == "" {
					<p role="alert" class="font-medium text-danger">{ errMsg }</p>
				}
				<div class="grid">
					@Button("primary", templ.Attributes{"type": "submit"}) {
						Criar pedido
					}
				</div>
			</form>
		</main>
	}
}

templ OrderEditorPage(o db.Order, menu []db.Category) {
	@Layout(fmt.Sprintf("Pedido #%d · Ukemochi", o.ID)) {
		<main class="mx-auto max-w-lg pb-40">
			@orderHeader(o, false)
			<div id="pedido-itens" class="p-4">
				@orderItems(o)
			</div>
			@BottomSheet("acoes-sheet", fmt.Sprintf("Pedido #%d", o.ID)) {
				@orderActions(o, false)
			}
			<div class="fixed inset-x-0 bottom-0 z-20 mx-auto grid max-w-lg gap-2 p-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
				@Button("secondary", templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("document.getElementById('acoes-sheet').showModal()")}) {
					Ações
				}
				if canEditItems(o) {
					<a
						href={ templ.SafeURL(addItemURL(o.ID, "", 0)) }
						hx-get={ addItemURL(o.ID, "", 0) }
						hx-target="#add-step"
						onclick="document.getElementById('add-sheet').showModal()"
						class={ buttonClass("primary") }
					>+ Adicionar item</a>
				}
			</div>
			if canEditItems(o) {
				@BottomSheet("add-sheet", "Adicionar item") {
					// After an add, ItemAdded swaps the product's category in here and the sheet stays open.
					<div id="add-step">
						@AddCategoryStep(o.ID, menu)
					</div>
				}
			}
			if canPay(o) {
				@BottomSheet("pagamento-sheet", "Pagamento") {
					@PaymentPanel(o, false)
				}
			}
			if canChangeConsume(o) {
				@BottomSheet("consumo-sheet", "Entrega") {
					@ConsumePanel(o)
				}
			}
			if canEditCustomer(o) {
				@BottomSheet("cliente-sheet", "Cliente") {
					@CustomerPanel(o)
				}
			}
		</main>
		@copyScript()
		@splitScript()
	}
}

// orderHeader shows who the order is for and its status. oob marks it for an htmx out-of-band swap.
templ orderHeader(o db.Order, oob bool) {
	<header
		id="pedido-cabecalho"
		if oob {
			hx-swap-oob="true"
		}
		class="sticky top-0 z-10 border-b border-line bg-surface/95 p-4 backdrop-blur"
	>
		<div class="flex items-center gap-2">
			@HomeLink()
			<div class="min-w-0 flex-1">
				<h1 class="line-clamp-2 break-words text-lg font-bold">#{ strconv.FormatInt(o.ID, 10) } { o.ClientLabel() }</h1>
				<p class="text-sm text-ink-muted">
					{ channelLabels[o.Channel] } · { consumeLabels[o.Consume] }
				</p>
			</div>
			@StatusChip(o.Status)
		</div>
		if o.Consume == db.ConsumeDelivery && o.Address != "" {
			<p class="mt-2 text-sm">Endereço: { o.Address }</p>
		}
		if o.Notes != "" {
			<p class="mt-2 text-sm">Obs: { o.Notes }</p>
		}
	</header>
}

// ConsumeUpdate answers an htmx consume change: the delivery sheet, then the actions sheet and header out of band.
// The handler's HX-Trigger (consumo-salvo) sends the delivery sheet back to the actions sheet.
templ ConsumeUpdate(o db.Order) {
	@ConsumePanel(o)
	@orderActions(o, true)
	@orderHeader(o, true)
}

// PaymentUpdate answers an htmx payment change: the payment sheet, which stays open for the next part,
// then the actions sheet (its summary and close button follow the payment) and a toast out of band.
templ PaymentUpdate(o db.Order, toast string) {
	@PaymentPanel(o, false)
	@orderActions(o, true)
	if toast != "" {
		@Toast("ok", toast)
	}
}

// consumeSummary shows how the order is consumed in the order panel, with a button that opens the delivery sheet.
templ consumeSummary(o db.Order) {
	<section class="space-y-3 rounded-xl border border-line p-3" aria-labelledby="consumo-titulo">
		<h3 id="consumo-titulo" class="font-semibold">Entrega</h3>
		if o.Consume == db.ConsumeDelivery {
			<p>
				Entrega
				if o.Address != "" {
					<span class="text-ink-muted">· { o.Address }</span>
				}
			</p>
		} else {
			<p>Consumir no local</p>
		}
		<div class="grid">
			@Button("secondary", templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("this.closest('dialog')?.close(); document.getElementById('consumo-sheet').showModal()")}) {
				Alterar entrega
			}
		</div>
	</section>
}

// ConsumePanel is the body of the delivery sheet: the address and the entrega / local choice.
templ ConsumePanel(o db.Order) {
	<div id="consumo" class="space-y-3">
		<p id="consumo-erro" role="alert" class="empty:hidden font-medium text-danger"></p>
		<form
			method="post"
			action={ orderURL(o.ID) + "/consumo" }
			hx-post={ orderURL(o.ID) + "/consumo" }
			hx-target="#consumo"
			hx-swap="outerHTML"
			hx-on:consumo-salvo="document.getElementById('consumo-sheet').close(); document.getElementById('acoes-sheet').showModal()"
			class="grid grid-cols-2 gap-2"
		>
			<label class="col-span-2 block">
				<span class="mb-1 block text-sm font-medium text-ink-muted">Endereço (para entrega)</span>
				<input type="text" name="endereco" value={ o.Address } maxlength="120" autocomplete="off" class={ fieldClass() }/>
			</label>
			@Button(selectedVariant(o.Consume == db.ConsumeDelivery), templ.Attributes{"type": "submit", "name": "consumo", "value": db.ConsumeDelivery}) {
				Entrega
			}
			@Button(selectedVariant(o.Consume == db.ConsumeLocal), templ.Attributes{"type": "submit", "name": "consumo", "value": db.ConsumeLocal}) {
				Consumir no local
			}
		</form>
		@sheetBack("consumo-sheet", false)
	</div>
}

// sheetBack closes a sheet opened from the actions sheet and reopens the actions sheet, pinned to the sheet's bottom.
// primary highlights it when going back is the natural next step.
templ sheetBack(sheetID string, primary bool) {
	<div class="sticky bottom-0 grid bg-card pt-3 pb-[env(safe-area-inset-bottom)]">
		@Button(selectedVariant(primary), templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("document.getElementById('" + sheetID + "').close(); document.getElementById('acoes-sheet').showModal()")}) {
			Voltar
		}
	</div>
}

// copyScript makes every [data-copy] button copy the textarea it names.
templ copyScript() {
	<script>
			// Copy a message; without clipboard access (plain HTTP, old browser) show the text selected instead.
			document.addEventListener("click", async (e) => {
				const b = e.target.closest("[data-copy]");
				if (!b) return;
				const ta = document.getElementById(b.dataset.copy);
				if (!ta) return;
				try {
					await navigator.clipboard.writeText(ta.value);
					const label = b.textContent;
					b.textContent = "Copiado!";
					setTimeout(() => (b.textContent = label), 1500);
				} catch {
					ta.classList.remove("hidden");
					ta.nextElementSibling?.classList.remove("hidden");
					ta.focus();
					ta.select();
				}
			});
		</script>
}

// ItemsUpdate answers an htmx item edit: the new item list, plus the actions and payment sheets
// (their texts and totals follow the items) and a toast out of band.
templ ItemsUpdate(o db.Order, toast string) {
	@orderItems(o)
	@orderHeader(o, true) // the status may have gone back to aberto
	@orderActions(o, true)
	@PaymentPanel(o, true)
	if toast != "" {
		@Toast("ok", toast)
	}
}

// ItemAdded answers an htmx add: the item update, and the add sheet back on the product's category
// (the categories if it is gone), out of band.
templ ItemAdded(o db.Order, menu []db.Category, product int64) {
	@ItemsUpdate(o, "Item adicionado")
	if c, ok := productCategory(menu, product); ok {
		<div id="add-step" hx-swap-oob="innerHTML">
			@AddItemStep(o.ID, c)
		</div>
		@sheetTitle("add-sheet", c.Name, true)
	} else {
		<div id="add-step" hx-swap-oob="innerHTML">
			@AddCategoryStep(o.ID, menu)
		</div>
		@sheetTitle("add-sheet", "Adicionar item", true)
	}
}

// orderItems shows the items and total of an order, with quantity buttons while it is open.
templ orderItems(o db.Order) {
	{{ editable := canEditItems(o) }}
	{{ reopen := reopenNote(o) }}
	// hx-confirm is inherited by every item form below, so a change in cozinha or pronto asks first.
	<div
		class="space-y-4"
		if reopen != "" {
			hx-confirm={ reopen + " Continuar?" }
		}
	>
		<p id="sheet-error" role="alert" class="empty:hidden font-medium text-danger"></p>
		if len(o.Items) == 0 {
			<p class="text-ink-muted">Nenhum item ainda.</p>
		}
		<ul class="divide-y divide-line">
			for _, it := range o.Items {
				<li class="group/item flex flex-wrap items-center gap-x-3 py-2">
					{{ itemURL := fmt.Sprintf("/pedidos/%d/itens/%d", o.ID, it.ID) }}
					<div class="min-w-0 flex-1">
						if editable {
							// Tapping the name opens the line's note, on its own full-width row (the form after the quantity buttons).
							<details>
								<summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 font-medium leading-tight [&::-webkit-details-marker]:hidden">
									<span>{ it.PrintableName }</span>
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-ink-muted" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
									<span class="sr-only">(observação)</span>
								</summary>
							</details>
						} else {
							<p class="font-medium leading-tight">{ strconv.FormatInt(it.Qty, 10) }x { it.PrintableName }</p>
						}
						if it.Note != "" {
							<p class="text-sm text-ink-muted">{ it.Note }</p>
						}
						<p class="text-sm tabular-nums text-ink-muted">{ money.Format(it.Qty * it.UnitPriceCents) }</p>
					</div>
					if editable {
						<div class="flex items-center gap-1">
							if it.Qty == 1 {
								// At 1, minus would remove the line, so it asks first. htmx ignores onsubmit's result and asks with hx-confirm.
								<form method="post" action={ itemURL } hx-delete={ itemURL } hx-target="#pedido-itens" hx-swap="innerHTML" hx-confirm={ strings.TrimSpace("Remover " + it.NameSnapshot + "? " + reopen) } data-confirm={ "Remover " + it.NameSnapshot + "?" } onsubmit="return !!window.htmx || confirm(this.dataset.confirm)">
									<input type="hidden" name="qty" value="0"/>
									<button type="submit" class={ buttonClass("secondary") + " w-12 px-0 text-danger" } aria-label={ "Remover " + it.NameSnapshot } title="Remover">
										@trashIcon()
									</button>
								</form>
							}
							<form method="post" action={ itemURL } hx-patch={ itemURL } hx-target="#pedido-itens" hx-swap="innerHTML" class="flex items-center gap-1">
								if it.Qty > 1 {
									<button type="submit" name="qty" value={ strconv.FormatInt(it.Qty-1, 10) } class={ buttonClass("secondary") + " w-12 px-0" } aria-label={ "Diminuir " + it.NameSnapshot }>−</button>
								}
								<span class="w-8 text-center text-lg font-semibold tabular-nums">{ strconv.FormatInt(it.Qty, 10) }</span>
								<button type="submit" name="qty" value={ strconv.FormatInt(it.Qty+1, 10) } disabled?={ it.Qty >= db.MaxQty } class={ buttonClass("secondary") + " w-12 px-0" } aria-label={ "Aumentar " + it.NameSnapshot }>+</button>
							</form>
						</div>
						// Shown while the name's <details> is open.
						<form method="post" action={ itemURL } hx-patch={ itemURL } hx-target="#pedido-itens" hx-swap="innerHTML" class="mt-2 hidden w-full gap-2 group-has-[details[open]]/item:flex">
							<input type="text" name="nota" value={ it.Note } maxlength={ strconv.Itoa(db.MaxItemNote) } placeholder="Obs. do item, ex.: sem cebolinha" aria-label={ "Observação de " + it.NameSnapshot } autocomplete="off" class={ fieldClass() + " min-w-0 flex-1 text-base" }/>
							@Button("secondary", templ.Attributes{"type": "submit"}) {
								Salvar
							}
						</form>
					}
				</li>
			}
		</ul>
		<p class="flex justify-between text-xl font-bold"><span>Total</span><span class="tabular-nums">{ money.Format(o.TotalCents) }</span></p>
	</div>
}

// orderActions is the body of the actions sheet: copy messages, consume type, payment, status and print.
// oob marks it for an htmx out-of-band swap.
templ orderActions(o db.Order, oob bool) {
	<div
		id="acoes"
		if oob {
			hx-swap-oob="true"
		}
		class="space-y-4"
	>
		<p id="acoes-erro" role="alert" class="empty:hidden font-medium text-danger"></p>
		if canEditCustomer(o) {
			<div class="grid">
				@Button("secondary", templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("this.closest('dialog')?.close(); document.getElementById('cliente-sheet').showModal()")}) {
					Editar cliente
				}
			</div>
		}
		if canChangeConsume(o) {
			@consumeSummary(o)
		}
		@paymentSummary(o)
		if msgs := copyMessages(o); len(msgs) > 0 {
			<div class="grid gap-2">
				for _, m := range msgs {
					@Button("secondary", templ.Attributes{"type": "button", "data-copy": "msg-" + m.Kind}) {
						{ m.Label }
					}
					<textarea id={ "msg-" + m.Kind } readonly rows="6" class="hidden w-full rounded-xl border border-line bg-card p-3 text-sm">{ m.Text }</textarea>
					<p class="hidden text-sm text-ink-muted">Toque e segure para copiar</p>
				}
			</div>
		}
		// The next step (primary) shares a line with print; reopen and cancel go below.
		<div class="grid auto-cols-fr grid-flow-col items-start gap-2">
			for _, a := range statusActions {
				if a.Variant == "primary" && db.CanTransition(o.Status, a.To, o.Consume) {
					@statusForm(o, a.To, a.Label, a.Variant)
				}
			}
			<form method="post" action={ orderURL(o.ID) + "/imprimir" } hx-post={ orderURL(o.ID) + "/imprimir" } hx-target="#acoes" hx-disabled-elt="find button" class="grid">
				// Like Enviar à cozinha, nothing to print without items; the kitchen button's hint covers both.
				@Button("secondary", templ.Attributes{"type": "submit", "disabled": len(o.Items) == 0}) {
					Imprimir ticket
				}
			</form>
		</div>
		for _, a := range statusActions {
			if a.Variant != "primary" && db.CanTransition(o.Status, a.To, o.Consume) {
				@statusForm(o, a.To, a.Label, a.Variant)
			}
		}
	</div>
}

// statusForm is one status button. Fechar stays disabled until the order is paid, and
// Enviar à cozinha until it has items. Under htmx an error shows in #acoes-erro and success redirects.
templ statusForm(o db.Order, to, label, variant string) {
	{{ unpaid := to == db.StatusClosed && !o.Paid() }}
	{{ empty := to == db.StatusKitchen && len(o.Items) == 0 }}
	<form
		method="post"
		action={ orderURL(o.ID) + "/status" }
		hx-post={ orderURL(o.ID) + "/status" }
		hx-target="#acoes"
		hx-disabled-elt="find button"
		class="grid"
		if to == db.StatusCancelled {
			hx-confirm="Cancelar este pedido?"
			// htmx ignores onsubmit's result and asks with hx-confirm, so this asks only without htmx.
			onsubmit="return !!window.htmx || confirm('Cancelar este pedido?')"
		}
	>
		<input type="hidden" name="para" value={ to }/>
		@Button(variant, templ.Attributes{"type": "submit", "disabled": unpaid || empty}) {
			{ label }
		}
		if !empty && unpaid && o.PaymentCount == 0 {
			<p class="mt-1 text-center text-sm text-ink-muted">Registre o pagamento para fechar.</p>
		} else if !empty && unpaid {
			<p class="mt-1 text-center text-sm text-ink-muted">Os pagamentos não batem com o total.</p>
		}
	</form>
}

// sheetError fills the error line with the given id inside an open sheet, out of band.
templ sheetError(id, msg string) {
	<p id={ id } hx-swap-oob="true" role="alert" class="empty:hidden font-medium text-danger">{ msg }</p>
}

templ ErrorPage(msg string) {
	@Layout("Erro · Ukemochi") {
		<main class="mx-auto flex min-h-screen max-w-sm flex-col justify-center gap-4 p-4">
			@Card() {
				<p role="alert" class="text-lg font-semibold text-danger">{ msg }</p>
			}
			@Button("secondary", templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("history.back()")}) {
				Voltar
			}
			@LinkButton("ghost", "/") {
				Início
			}
		</main>
	}
}

// addItemURL is the add-item step URL: categories with no key, else ?key=id.
func addItemURL(orderID int64, key string, id int64) string {
	u := orderURL(orderID) + "/adicionar"
	if key != "" {
		u += "?" + key + "=" + strconv.FormatInt(id, 10)
	}
	return u
}

func menuEmpty(menu []db.Category) bool {
	for _, c := range menu {
		if len(c.Items) > 0 {
			return false
		}
	}
	return true
}

const stepTile = "flex min-h-20 flex-col items-start justify-between rounded-xl border border-line bg-card p-3 text-left shadow-sm active:scale-[0.98] active:bg-brand-soft"

// stepLink loads an add-item step into the sheet, or navigates to it without htmx.
templ stepLink(url, class string) {
	<a href={ templ.SafeURL(url) } hx-get={ url } hx-target="#add-step" class={ class }>
		{ children... }
	</a>
}

// AddItemPage is an add-item step as a full page, for browsers without htmx.
templ AddItemPage(o db.Order, title string, step templ.Component) {
	@Layout(fmt.Sprintf("Adicionar item · Pedido #%d · Ukemochi", o.ID)) {
		<main class="mx-auto max-w-lg">
			<header class="flex items-center gap-2 border-b border-line p-4">
				<a href={ templ.SafeURL(orderURL(o.ID)) } class={ buttonClass("ghost") } aria-label="Voltar">←</a>
				// Same id as the sheet title, so htmx steps (AddStepHX) rename it too.
				<h1 id="add-sheet-titulo" class="min-w-0 truncate text-lg font-bold">{ title }</h1>
			</header>
			<div id="add-step" class="p-4">
				@step
			</div>
		</main>
	}
}

// AddStepHX is an add-item step for htmx: it also renames the sheet to the current pick.
templ AddStepHX(title string, step templ.Component) {
	@sheetTitle("add-sheet", title, true)
	@step
}

// backStep is the full-width link back to the previous add-item step, pinned to the sheet's bottom while the cards scroll.
templ backStep(url string) {
	<div class="sticky bottom-0 grid bg-card pt-3 pb-[env(safe-area-inset-bottom)]">
		@stepLink(url, buttonClass("secondary")) {
			Voltar
		}
	</div>
}

// AddCategoryStep is step 1: pick a category.
templ AddCategoryStep(orderID int64, menu []db.Category) {
	if menuEmpty(menu) {
		<p class="text-ink-muted">Cardápio vazio. Cadastre produtos em <a href="/admin/cardapio" class="underline">Admin › Cardápio</a>.</p>
	} else {
		<div class="grid grid-cols-2 gap-2">
			for _, c := range menu {
				if len(c.Items) > 0 {
					@stepLink(addItemURL(orderID, "categoria", c.ID), stepTile) {
						<span class="font-semibold leading-tight">{ c.Name }</span>
					}
				}
			}
		</div>
	}
}

// AddItemStep is step 2: pick an item of the category. An item with one product skips to quantity.
templ AddItemStep(orderID int64, c db.Category) {
	<div class="space-y-3">
		<div class="grid grid-cols-2 gap-2">
			for _, it := range c.Items {
				if len(it.Products) == 1 {
					@stepLink(addItemURL(orderID, "produto", it.Products[0].ID), stepTile) {
						<span class="font-semibold leading-tight">{ db.DisplayName(it.Name, it.Products[0].Variant, it.Products[0].Size) }</span>
						<span class="text-sm tabular-nums text-ink-muted">{ money.Format(it.Products[0].PriceCents) }</span>
					}
				} else {
					@stepLink(addItemURL(orderID, "item", it.ID), stepTile) {
						<span class="font-semibold leading-tight">{ it.Name }</span>
						<span class="text-sm tabular-nums text-ink-muted">a partir de { money.Format(it.Products[0].PriceCents) }</span>
					}
				}
			}
		</div>
		@backStep(addItemURL(orderID, "", 0))
	</div>
}

// AddVariantStep is step 3: pick a product (variant/size) of the item.
templ AddVariantStep(orderID int64, c db.Category, it db.Item) {
	<div class="space-y-3">
		<div class="grid grid-cols-2 gap-2">
			for _, p := range it.Products {
				@stepLink(addItemURL(orderID, "produto", p.ID), stepTile) {
					<span class="font-semibold leading-tight">{ variantLabel(it, p) }</span>
					<span class="text-sm tabular-nums text-ink-muted">{ money.Format(p.PriceCents) }</span>
				}
			}
		</div>
		@backStep(addItemURL(orderID, "categoria", c.ID))
	</div>
}

// AddQtyStep is step 4: pick the quantity and add.
// reopen is the order's reopenNote: the add asks first when it would send the order back to aberto.
templ AddQtyStep(orderID int64, c db.Category, it db.Item, p db.Product, reopen string) {
	<div class="space-y-4">
		<p class="tabular-nums text-ink-muted">{ money.Format(p.PriceCents) } cada</p>
		<form
			method="post"
			action={ orderURL(orderID) + "/itens" }
			hx-post={ orderURL(orderID) + "/itens" }
			hx-target="#pedido-itens"
			hx-swap="innerHTML"
			if reopen != "" {
				hx-confirm={ reopen + " Continuar?" }
			}
		>
			<input type="hidden" name="produto" value={ strconv.FormatInt(p.ID, 10) }/>
			<div class="flex items-center gap-2">
				<button type="button" onclick="this.form.qty.stepDown()" class={ buttonClass("secondary") + " w-12 shrink-0 px-0 text-2xl" } aria-label="Menos">−</button>
				<input type="number" name="qty" value="1" min="1" max={ strconv.FormatInt(db.MaxQty, 10) } inputmode="numeric" required aria-label="Quantidade" class="h-12 w-14 shrink-0 rounded-xl border border-line bg-card text-center text-xl font-semibold tabular-nums"/>
				<button type="button" onclick="this.form.qty.stepUp()" class={ buttonClass("secondary") + " w-12 shrink-0 px-0 text-2xl" } aria-label="Mais">+</button>
				<div class="grid flex-1">
					@Button("primary", templ.Attributes{"type": "submit"}) {
						Adicionar
					}
				</div>
			</div>
		</form>
		if len(it.Products) > 1 {
			@backStep(addItemURL(orderID, "item", it.ID))
		} else {
			@backStep(addItemURL(orderID, "categoria", c.ID))
		}
	</div>
}

// variantLabel names a product within its item, e.g. "1/2 (4un)"; the item name if it has neither.
func variantLabel(it db.Item, p db.Product) string {
	if l := strings.TrimSpace(p.Variant + " " + p.Size); l != "" {
		return l
	}
	return it.Name
}
