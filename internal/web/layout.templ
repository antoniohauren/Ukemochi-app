package web

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="theme-color" content="#b91c1c"/>
			<title>{ title }</title>
			<link rel="manifest" href="/static/manifest.webmanifest"/>
			<link rel="icon" href="/static/icons/icon-192.png"/>
			<link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png"/>
			<script>
				// Runs before paint so a dark page never flashes white. No saved choice: follow the phone.
				try {
					const t = localStorage.getItem("theme");
					if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches)) document.documentElement.classList.add("dark");
				} catch (e) {}
				function toggleTheme() {
					const dark = document.documentElement.classList.toggle("dark");
					try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (e) {}
				}
			</script>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script>
				if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js");
				// A toast arrives out of band; showing it as a popover puts it in the top layer, above an open sheet.
				document.addEventListener("htmx:load", (e) => {
					const t = e.target;
					if (t.id === "toast" && t.showPopover && t.childElementCount) t.showPopover();
				});
				// Safari ignores closedby="any": a tap on a sheet's backdrop hits the dialog itself, so close it here.
				document.addEventListener("click", (e) => {
					const d = e.target;
					if (d instanceof HTMLDialogElement && d.open && d.classList.contains("sheet") && !("closedBy" in d)) d.close();
				});
			</script>
		</head>
		<body class="min-h-screen bg-surface text-ink">
			{ children... }
			@ToastRegion()
		</body>
	</html>
}
