package web

templ LoginPage(next, errMsg string) {
	@Layout("Entrar · Ukemochi") {
		<main class="mx-auto flex min-h-screen max-w-sm flex-col justify-center p-4">
			@Card() {
				<form method="post" action="/admin/login" class="space-y-4">
					<h1 class="text-xl font-bold">Área do administrador</h1>
					<input type="hidden" name="next" value={ next }/>
					<label class="block">
						<span class="mb-1 block text-sm font-medium text-ink-muted">PIN</span>
						<input
							type="password"
							name="pin"
							inputmode="numeric"
							autocomplete="current-password"
							required
							autofocus
							class="min-h-12 w-full rounded-xl border border-line bg-card px-4 text-center text-2xl tracking-widest outline-none focus:border-brand focus:ring-2 focus:ring-brand-soft"
						/>
					</label>
					if errMsg != "" {
						<p role="alert" class="text-sm font-medium text-danger">{ errMsg }</p>
					}
					<div class="grid">
						@Button("primary", templ.Attributes{"type": "submit"}) {
							Entrar
						}
					</div>
				</form>
			}
		</main>
	}
}
