package web

import (
	"fmt"
	"strconv"

	"github.com/antoniohauren/ukemochi/internal/db"
	"github.com/antoniohauren/ukemochi/internal/money"
)

// paymentSummary shows the recorded payment in the order panel, with a button that opens the payment sheet.
templ paymentSummary(o db.Order) {
	<section class="space-y-3 rounded-xl border border-line p-3" aria-labelledby="pagamento-titulo">
		<h3 id="pagamento-titulo" class="font-semibold">Pagamento</h3>
		@paymentList(o, false)
		@paymentStatus(o)
		if t := expectedText(o); t != "" {
			<p class="text-sm">Paga na entrega: { t }</p>
		}
		if canPay(o) {
			// A delivery with something left to pay offers Paga na entrega next to the payment button:
			// it opens its own sheet, where the expected payment printed under A PAGAR is set.
			{{ onDelivery := payOnDelivery(o) }}
			<div class={ "grid gap-2", templ.KV("grid-cols-2", onDelivery) }>
				@Button("secondary", templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("this.closest('dialog')?.close(); document.getElementById('pagamento-sheet').showModal()")}) {
					if onDelivery && o.PaymentCount == 0 {
						Já pagou
					} else if o.PaymentCount == 0 {
						Registrar pagamento
					} else {
						Alterar pagamento
					}
				}
				if onDelivery {
					@Button("secondary", templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("this.closest('dialog')?.close(); document.getElementById('entrega-pagamento-sheet').showModal()")}) {
						Paga na entrega
					}
				}
			</div>
		}
	</section>
}

// paymentStatus says whether the parts cover the total: unpaid, paid, short or over.
templ paymentStatus(o db.Order) {
	switch  {
		case o.PaymentCount == 0:
			<p class="text-ink-muted">Não pago.</p>
		case o.Paid():
			<p class="font-medium text-ok">
				if o.PaymentCount == 1 {
					Pago com { paymentLabels[o.Payments[0].Method] }
				} else {
					Pago em { strconv.FormatInt(o.PaymentCount, 10) } partes
				}
			</p>
		case o.RemainingCents() > 0:
			<p role="alert" class="flex justify-between text-lg font-semibold tabular-nums text-danger"><span>Falta</span><span>{ money.Format(o.RemainingCents()) }</span></p>
		default:
			// Items removed after paying (reopened order).
			<p role="alert" class="font-medium tabular-nums text-danger">Pago { money.Format(-o.RemainingCents()) } a mais. Remova um pagamento.</p>
	}
}

// paymentList lists the payment parts; removable adds a remove button to each.
templ paymentList(o db.Order, removable bool) {
	if len(o.Payments) > 0 {
		<ul class="divide-y divide-line">
			for _, p := range o.Payments {
				<li class="flex items-center gap-3 py-2">
					<div class="min-w-0 flex-1">
						<p class="flex justify-between font-medium tabular-nums">
							<span>{ paymentLabels[p.Method] } <span class="text-sm font-normal text-ink-muted">{ localTime(p.PaidAt, "15:04") }</span></span>
							<span>{ money.Format(p.AmountCents) }</span>
						</p>
						if len(p.Items) > 0 {
							<p class="text-sm text-ink-muted">{ paymentItemsText(p) }</p>
						}
						if p.CashGivenCents > 0 {
							<p class="text-sm tabular-nums text-ink-muted">Recebido { money.Format(p.CashGivenCents) } · Troco { money.Format(p.CashGivenCents - p.AmountCents) }</p>
						}
					</div>
					if removable {
						{{ u := paymentURL(o.ID, p.ID) }}
						{{ ask := "Remover pagamento " + paymentLabels[p.Method] + " de " + money.Format(p.AmountCents) + "?" }}
						// A trash icon, not ✕, so it is not mistaken for the sheet's close button. htmx asks with hx-confirm.
						<form method="post" action={ u } hx-delete={ u } hx-target="#pagamento" hx-swap="outerHTML" hx-confirm={ ask } data-confirm={ ask } onsubmit="return !!window.htmx || confirm(this.dataset.confirm)">
							<button type="submit" class={ buttonClass("secondary") + " w-12 px-0 text-danger" } aria-label={ "Remover pagamento " + paymentLabels[p.Method] + " " + money.Format(p.AmountCents) } title="Remover">
								@trashIcon()
							</button>
						</form>
					}
				</li>
			}
		</ul>
	}
}

// PaymentPanel is the body of the payment sheet: the total, the parts paid so far and the form for the next part.
// The split picker starts at o.SplitPeople (1 pays all that is left), stored with each part, so it survives a reload.
// oob marks it for an htmx out-of-band swap when the order's items change.
templ PaymentPanel(o db.Order, oob bool) {
	<div
		id="pagamento"
		if oob {
			hx-swap-oob="true"
		}
		class="space-y-3"
	>
		<p id="pagamento-erro" role="alert" class="empty:hidden font-medium text-danger"></p>
		<p class="flex justify-between text-xl font-bold"><span>Total</span><span class="tabular-nums">{ money.Format(o.TotalCents) }</span></p>
		@paymentList(o, canPay(o))
		if o.PaymentCount > 0 {
			@paymentStatus(o)
		}
		if canAddPayment(o) {
			{{ rest := o.RemainingCents() }}
			<form
				method="post"
				action={ orderURL(o.ID) + "/pagamento" }
				hx-post={ orderURL(o.ID) + "/pagamento" }
				hx-target="#pagamento"
				hx-swap="outerHTML"
				hx-on::after-request="document.getElementById('pagamento-erro')?.scrollIntoView({block: 'nearest'})"
				onchange="if (event.target.name === 'metodo') document.getElementById('pagamento-erro').textContent = ''"
				novalidate
				class="group space-y-3 border-t border-line pt-3"
			>
				{{ people := max(o.SplitPeople, 1) }}
				{{ share := db.EqualShare(o.TotalCents, people) }}
				{{ mode := paymentMode(o) }}
				if rest > 0 {
					// Tudo, Dividir and Por consumo each show their own screen (CSS on the checked radio);
					// splitScript fills the amount for the mode picked.
					<fieldset data-rest={ plainMoney(rest) }>
						<legend class="mb-1 text-sm font-medium text-ink-muted">Como pagar</legend>
						<div class={ "grid gap-2", templ.KV("grid-cols-3", canPayByConsumption(o)), templ.KV("grid-cols-2", !canPayByConsumption(o)) }>
							for _, m := range paymentModes(o) {
								<label class={ optionClass() + " px-2 text-center leading-tight" }>
									<input type="radio" name="modo" value={ m } id={ "modo-" + m } checked?={ m == mode } class="sr-only"/>
									{ paymentModeLabels[m] }
								</label>
							}
						</div>
					</fieldset>
					// Dividir: picking how many people split the bill fills the amount with one share.
					<div class="hidden group-has-[#modo-dividir:checked]:block" data-total={ strconv.FormatInt(o.TotalCents, 10) } data-rest={ strconv.FormatInt(rest, 10) } data-paid={ strconv.FormatInt(o.PaymentCount, 10) }>
						<span class="mb-1 flex justify-between text-sm font-medium text-ink-muted">
							<span>Dividir entre</span>
							<span data-part>{ partLabel(o, people) }</span>
						</span>
						<div class="flex items-center gap-2">
							<button type="button" data-split-step="-" class={ buttonClass("secondary") + " w-12 shrink-0 px-0 text-2xl" } aria-label="Menos pessoas">−</button>
							<input type="number" name="pessoas" value={ strconv.FormatInt(people, 10) } min="1" max={ strconv.FormatInt(maxPeople, 10) } inputmode="numeric" aria-label="Pessoas" class="h-12 w-14 shrink-0 rounded-xl border border-line bg-card text-center text-xl font-semibold tabular-nums"/>
							<button type="button" data-split-step="+" class={ buttonClass("secondary") + " w-12 shrink-0 px-0 text-2xl" } aria-label="Mais pessoas">+</button>
							<p class="min-w-0 flex-1 text-right leading-tight">
								<span data-share class="block font-semibold tabular-nums">{ money.Format(share) }</span>
								<span class="text-sm text-ink-muted">por pessoa</span>
							</p>
						</div>
					</div>
					if canPayByConsumption(o) {
						<div class="hidden group-has-[#modo-consumo:checked]:block">
							@consumptionPicker(o)
						</div>
					}
				}
				<fieldset>
					<legend class="mb-1 text-sm font-medium text-ink-muted">Forma de pagamento</legend>
					<div class="grid grid-cols-2 gap-2">
						for _, m := range db.PaymentMethods {
							<label class={ optionClass() }>
								<input type="radio" name="metodo" value={ m } id={ "pagamento-" + m } class="sr-only" required/>
								{ paymentLabels[m] }
							</label>
						}
					</div>
				</fieldset>
				{{ split := plainMoney(partAmount(o, people)) }}
				@MoneyInput("valor", "Valor a pagar", modeAmount(o, mode, people), templ.Attributes{"data-default": split, "readonly": mode == modeAll || mode == modeConsumption})
				// Shown only while Dinheiro is checked.
				<div class="hidden space-y-2 group-has-[#pagamento-dinheiro:checked]:block">
					@MoneyInput("recebido", "Valor recebido (opcional)", "", nil)
					@ChangeLine("", "", true)
				</div>
				// Refreshes the change line whenever the amount or the cash changes.
				<div
					hidden
					hx-get={ orderURL(o.ID) + "/troco" }
					hx-trigger="input delay:300ms from:closest form"
					hx-include="closest form"
					hx-target="#troco"
					hx-swap="outerHTML"
					hx-sync="this:replace"
				></div>
				<div class="grid">
					@Button("primary", templ.Attributes{"type": "submit"}) {
						Registrar pagamento
					}
				</div>
			</form>
		}
		@sheetBack("pagamento-sheet", o.Paid())
	</div>
}

// consumptionPicker lets one person pay for what they consumed: a stepper per order line, up to the units
// not yet paid this way. Any pick fills the amount with their sum and locks it (splitScript); the server
// recomputes it from the units.
templ consumptionPicker(o db.Order) {
	<section class="rounded-xl border border-line">
		<p class="flex min-h-12 items-center justify-between gap-2 px-3 font-semibold">
			<span>Consumido</span>
			<span data-units-sum class="tabular-nums text-ink-muted"></span>
		</p>
		<p class="px-3 text-sm text-ink-muted">Marque o que esta pessoa consumiu. O valor é a soma dos itens.</p>
		<ul class="divide-y divide-line px-3">
			for _, it := range o.Items {
				{{ left := it.UnpaidQty() }}
				{{ split := max(it.SplitParts, 1) }}
				<li class="space-y-2 py-2">
					<div class="flex items-center gap-2">
						<div class="min-w-0 flex-1">
							<p class="break-words font-medium">{ it.NameSnapshot }</p>
							<p class="text-sm tabular-nums text-ink-muted">{ consumptionText(it) }</p>
						</div>
						if left > 0 {
							// The steppers count parts: units, or shares of a unit when the item is divided.
							<button type="button" data-units-step="-" class={ buttonClass("secondary") + " w-12 shrink-0 px-0 text-2xl" } aria-label={ "Menos " + it.NameSnapshot }>−</button>
							<input
								type="number"
								name={ unitsField(it.ID) }
								value="0"
								min="0"
								max={ strconv.FormatInt(left, 10) }
								data-line-total={ strconv.FormatInt(it.Qty*it.UnitPriceCents, 10) }
								data-parts={ strconv.FormatInt(it.Parts(), 10) }
								data-paid={ strconv.FormatInt(it.PaidQty, 10) }
								inputmode="numeric"
								aria-label={ "Quantidade de " + it.NameSnapshot }
								class="h-12 w-12 shrink-0 rounded-xl border border-line bg-card text-center text-xl font-semibold tabular-nums"
							/>
							<button type="button" data-units-step="+" class={ buttonClass("secondary") + " w-12 shrink-0 px-0 text-2xl" } aria-label={ "Mais " + it.NameSnapshot }>+</button>
						}
					</div>
					// A shared item (a 1L soda for three) is divided into parts until one is paid.
					if it.PaidQty == 0 {
						{{ u := orderURL(o.ID) + "/itens/" + strconv.FormatInt(it.ID, 10) + "/partes" }}
						<div class="flex items-center gap-2 text-sm">
							<span class="flex-1 text-ink-muted">Dividir item entre</span>
							<button type="button" hx-post={ u } hx-vals={ splitVals(split - 1) } hx-target="#pagamento" hx-swap="outerHTML" disabled?={ split <= 1 } class={ buttonClass("secondary") + " min-h-10 w-10 shrink-0 px-0 text-xl" } aria-label={ "Dividir " + it.NameSnapshot + " entre menos pessoas" }>−</button>
							<span class="w-16 text-center font-semibold tabular-nums">
								if split == 1 {
									1 pessoa
								} else {
									{ strconv.FormatInt(split, 10) } pessoas
								}
							</span>
							<button type="button" hx-post={ u } hx-vals={ splitVals(split + 1) } hx-target="#pagamento" hx-swap="outerHTML" disabled?={ split >= db.MaxSplitParts } class={ buttonClass("secondary") + " min-h-10 w-10 shrink-0 px-0 text-xl" } aria-label={ "Dividir " + it.NameSnapshot + " entre mais pessoas" }>+</button>
						</div>
					}
				</li>
			}
		</ul>
	</section>
}

// DeliveryPaymentPanel is the body of the Pagamento na entrega sheet: what the courier collects and how the
// client will pay it (the expected payment, POST /pedidos/{id}/pagamento-previsto), printed under A PAGAR.
// It never counts as paid. oob marks it for an htmx out-of-band swap when the total, payment or consume changes.
templ DeliveryPaymentPanel(o db.Order, oob bool) {
	<div
		id="pagamento-entrega"
		if oob {
			hx-swap-oob="true"
		}
		class="space-y-3"
	>
		<p id="pagamento-entrega-erro" role="alert" class="empty:hidden font-medium text-danger"></p>
		if payOnDelivery(o) {
			<p class="flex justify-between text-xl font-bold"><span>A cobrar</span><span class="tabular-nums">{ money.Format(o.RemainingCents()) }</span></p>
			<form
				method="post"
				action={ orderURL(o.ID) + "/pagamento-previsto" }
				hx-post={ orderURL(o.ID) + "/pagamento-previsto" }
				hx-target="#pagamento-entrega"
				hx-swap="outerHTML"
				hx-on:previsto-salvo="document.getElementById('entrega-pagamento-sheet').close(); document.getElementById('acoes-sheet').showModal()"
				novalidate
				class="group space-y-3"
			>
				<p class="text-sm text-ink-muted">O entregador cobra na entrega.</p>
				<fieldset>
					<legend class="mb-1 text-sm font-medium text-ink-muted">Como o cliente vai pagar</legend>
					<div class="grid grid-cols-2 gap-2">
						for _, m := range db.PaymentMethods {
							<label class={ optionClass() }>
								<input type="radio" name="previsto" value={ m } id={ "entrega-" + m } checked?={ o.ExpectedMethod == m } class="sr-only"/>
								{ paymentLabels[m] }
							</label>
						}
						<label class={ optionClass() + " col-span-2" }>
							<input type="radio" name="previsto" value="" checked?={ o.ExpectedMethod == "" } class="sr-only"/>
							Não informado
						</label>
					</div>
				</fieldset>
				<div class="hidden group-has-[#entrega-dinheiro:checked]:block">
					@MoneyInput("troco_para", "Troco para (opcional)", changeForValue(o), nil)
				</div>
				<div class="grid">
					@Button("primary", templ.Attributes{"type": "submit"}) {
						Salvar
					}
				</div>
			</form>
		} else {
			<p class="text-ink-muted">Nada a cobrar na entrega.</p>
		}
		@sheetBack("entrega-pagamento-sheet", false)
	</div>
}

// changeForValue fills the Troco para field with the stored note, or leaves it empty.
func changeForValue(o db.Order) string {
	if o.ChangeForCents <= 0 {
		return ""
	}
	return plainMoney(o.ChangeForCents)
}

// splitScript drives the payment form. The Como pagar buttons fill the amount for their screen: Tudo all that
// is left (locked), Dividir one share, Por consumo the sum of the picked units (locked, empty until one is picked).
// In Dividir, − and + step the people picker and any change fills one share, like partAmount: db.EqualShare
// (total / people, rounded up), capped at what is left; the last part is all that is left. In Por consumo the
// steppers do the same with the units. Integer centavos only.
templ splitScript() {
	<script>
		{
			const fmt = (c) => String((c - (c % 100)) / 100).replace(/\B(?=(\d{3})+(?!\d))/g, ".") + "," + String(c % 100).padStart(2, "0");
			const setValue = (v, value, locked) => {
				v.value = value;
				v.readOnly = locked;
				v.dispatchEvent(new Event("input", { bubbles: true }));
			};
			// Like db.OrderItem.PartsCost: the first m parts cost lineTotal * m / parts, rounded up.
			const unitsTotal = (form) => {
				let total = 0;
				for (const u of form.querySelectorAll("input[data-line-total]")) {
					const n = Math.max(0, Math.min(Number(u.max), parseInt(u.value, 10) || 0));
					const line = Number(u.dataset.lineTotal), parts = Number(u.dataset.parts), paid = Number(u.dataset.paid);
					const cum = (m) => { const x = Math.min(m, parts) * line + parts - 1; return (x - (x % parts)) / parts; };
					total += cum(paid + n) - cum(paid);
				}
				return total;
			};
			const fill = (form) => {
				const v = form.valor, mode = form.querySelector("[name=modo]:checked")?.value;
				if (mode === "tudo") return setValue(v, form.querySelector("[data-rest]").dataset.rest, true);
				if (mode === "dividir") return setValue(v, v.dataset.default, false);
				if (mode === "consumo") {
					const total = unitsTotal(form);
					form.querySelector("[data-units-sum]").textContent = total > 0 ? "R$ " + fmt(total) : "";
					return setValue(v, total > 0 ? fmt(total) : "", true);
				}
			};
			document.addEventListener("click", (e) => {
				const b = e.target.closest("[data-split-step], [data-units-step]");
				if (!b) return;
				const n = b.dataset.splitStep ? b.form.pessoas : b.parentElement.querySelector("input[data-line-total]");
				(b.dataset.splitStep || b.dataset.unitsStep) === "+" ? n.stepUp() : n.stepDown();
				n.dispatchEvent(new Event("input", { bubbles: true }));
			});
			document.addEventListener("change", (e) => {
				if (e.target.name === "modo") fill(e.target.form);
			});
			document.addEventListener("input", (e) => {
				const form = e.target.form;
				if (e.target.name === "pessoas") {
					const box = e.target.closest("[data-total]");
					const total = Number(box.dataset.total), rest = Number(box.dataset.rest), paid = Number(box.dataset.paid);
					const n = Math.max(1, Math.min(Number(e.target.max), parseInt(e.target.value, 10) || 1));
					const up = total + n - 1;
					const share = (up - (up % n)) / n;
					box.querySelector("[data-share]").textContent = "R$ " + fmt(share);
					box.querySelector("[data-part]").textContent = n > 1 ? "Parte " + Math.min(paid + 1, n) + " de " + n : "";
					form.valor.dataset.default = fmt(paid + 1 >= n ? rest : Math.min(share, rest));
					fill(form);
				} else if ("lineTotal" in e.target.dataset) {
					fill(form);
				}
			});
		}
	</script>
}

// ChangeLine is the live change line under the cash field, swapped by GET /pedidos/{id}/troco.
templ ChangeLine(label, amount string, ok bool) {
	<p id="troco" aria-live="polite" class="flex min-h-8 items-baseline justify-between text-lg font-semibold tabular-nums">
		<span class="text-ink-muted">{ label }</span>
		<span class={ templ.KV("text-ok", ok), templ.KV("text-danger", !ok) }>{ amount }</span>
	</p>
}

// plainMoney formats cents for a MoneyInput, which already shows the R$ prefix: "50,00".
func plainMoney(cents int64) string {
	return money.Format(cents)[len("R$ "):]
}

// partLabel names the part being paid when the bill is split: "Parte 2 de 3". Empty for one person.
func partLabel(o db.Order, people int64) string {
	if people < 2 {
		return ""
	}
	return fmt.Sprintf("Parte %d de %d", min(o.PaymentCount+1, people), people)
}

// modeAmount fills the amount field for the mode the sheet opens on: all that is left, one share, or nothing
// until items are picked.
func modeAmount(o db.Order, mode string, people int64) string {
	switch mode {
	case modeSplit:
		return plainMoney(partAmount(o, people))
	case modeConsumption:
		return ""
	}
	return plainMoney(o.RemainingCents())
}

// partAmount fills the amount field: one share capped at what is left, or all that is left on the last part,
// so a total that changed mid-split (an item added) is still paid in full.
func partAmount(o db.Order, people int64) int64 {
	rest := o.RemainingCents()
	if o.PaymentCount+1 >= people {
		return rest
	}
	return min(db.EqualShare(o.TotalCents, people), rest)
}

func paymentURL(orderID, paymentID int64) string {
	return orderURL(orderID) + "/pagamentos/" + strconv.FormatInt(paymentID, 10)
}
