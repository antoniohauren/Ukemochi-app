# Copy to .env (not committed). The app reads .env next to its binary or in the working directory; make run and make seed load it too.
ADDR=127.0.0.1:8080
DB_PATH=ukemochi.db
# At least 6 characters.
ADMIN_PIN=
# At least 32 characters: openssl rand -hex 32
SESSION_KEY=
TZ=America/Sao_Paulo
# Bluetooth address of the ESC/POS printer, paired on this machine (Linux only). Empty: print from the phone's browser.
PRINTER_BT=
# Ticket item lines. full: name, then "1x" and the price. compact: "1x name", no price.
TICKET_ITEMS=compact
