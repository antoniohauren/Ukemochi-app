# Copy to .env (not committed). The app reads .env next to its binary or in the working directory; make run and make seed load it too.
ADDR=127.0.0.1:8080
DB_PATH=ukemochi.db
# At least 6 characters.
ADMIN_PIN=
# At least 32 characters: openssl rand -hex 32
SESSION_KEY=
TZ=America/Sao_Paulo
# Bluetooth address of the ESC/POS printer, paired on this machine (Linux or Windows). Empty: print from the phone's browser.
PRINTER_BT=
# 1: log each ticket in the server output instead of sending it to the printer. Overrides PRINTER_BT.
PRINT_PREVIEW=
